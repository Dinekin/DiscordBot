<!DOCTYPE html>
<html lang="pl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Wiatry - <%= guild.name %></title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/dark-mode.css">
  <script src="/js/saved-style.js"></script>
</head>
<body>
  <%- include('../partials/navbar') %>

  <div class="container mt-4">
    <div class="row">
      <%- include('../partials/guild-sidebar', { path: '/dashboard/guild/' + guild.id + '/wiatry' }) %>

      <div class="col-md-9">
        <div class="card shadow-sm mb-4">
          <div class="card-body">
            <h2 class="card-title">Wiatry</h2>
            <p class="card-text">Wybierz kanał i kliknij przycisk wiatru, aby wysłać wiadomość z informacjami o wybranym wietrze.</p>

            <!-- Wybór kanału -->
            <div class="mb-4">
              <label for="channelSelect" class="form-label">Wybierz kanał:</label>
              <div class="input-group">
                <select class="form-select channel-select" id="channelSelect">
                  <option value="">-- Wybierz kanał --</option>
                  <%
                    // Sortowanie kanałów: ulubione alfabetycznie, potem zwykłe alfabetycznie
                    const sortedChannels = channels.filter(c => !c.isSeparator).slice().sort((a, b) => {
                      const aFav = favoriteChannels.includes(a.id);
                      const bFav = favoriteChannels.includes(b.id);

                      if (aFav && !bFav) return -1;
                      if (!aFav && bFav) return 1;

                      return a.name.localeCompare(b.name);
                    });

                    // Oddziel ulubione od zwykłych jeśli istnieją obie grupy
                    const favoriteSortedChannels = sortedChannels.filter(c => favoriteChannels.includes(c.id));
                    const regularSortedChannels = sortedChannels.filter(c => !favoriteChannels.includes(c.id));

                    favoriteSortedChannels.forEach(channel => {
                      const isFavorite = favoriteChannels.includes(channel.id);
                      const favoriteLabel = isFavorite ? '★' : '';
                    %>
                      <option value="<%= channel.id %>" data-favorite="<%= isFavorite %>">
                        <%= favoriteLabel %> #<%= channel.name %>
                      </option>
                    <% }); %>

                    <% if (favoriteSortedChannels.length > 0 && regularSortedChannels.length > 0) { %>
                      <option value="" disabled>─────────</option>
                    <% } %>

                    <% regularSortedChannels.forEach(channel => {
                        const isFavorite = favoriteChannels.includes(channel.id);
                        const favoriteLabel = isFavorite ? '★' : '';
                    %>
                      <option value="<%= channel.id %>" data-favorite="<%= isFavorite %>">
                        <%= favoriteLabel %> #<%= channel.name %>
                      </option>
                    <% }); %>
                </select>
                <button class="btn btn-outline-secondary favorite-toggle-btn" type="button" id="favoriteChannelBtnWiatry" title="Dodaj/usuń z ulubionych">
                  <i class="far fa-star" id="favoriteIconWiatry"></i>
                </button>
              </div>
            </div>

            <!-- Wiatry główne -->
            <div class="card mb-4">
              <div class="card-header">
                <h5 class="mb-0">Wiatry główne</h5>
              </div>
              <div class="card-body">
                <div class="row g-2">
                  <% wiatry.glowne.forEach(wiatr => { %>
                    <div class="col-md-3 col-sm-6">
                      <button type="button" class="btn btn-outline-primary w-100" onclick="sendWiatr('<%= wiatr.value %>')">
                        <i class="fas fa-wind me-2"></i><%= wiatr.name %>
                      </button>
                    </div>
                  <% }); %>
                </div>
              </div>
            </div>

            <!-- Kombinacje wiatrów -->
            <div class="card mb-4">
              <div class="card-header">
                <h5 class="mb-0">Kombinacje wiatrów</h5>
              </div>
              <div class="card-body">
                <div class="row g-2">
                  <% wiatry.kombinacje.forEach(wiatr => { %>
                    <div class="col-md-3 col-sm-6">
                      <button type="button" class="btn btn-outline-secondary w-100" onclick="sendWiatr('<%= wiatr.value %>')">
                        <i class="fas fa-wind me-2"></i><%= wiatr.name %>
                      </button>
                    </div>
                  <% }); %>
                </div>
              </div>
            </div>

            <!-- Status wysyłania -->
            <div id="statusAlert" class="alert" style="display: none;" role="alert"></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
  <script src="/js/dark-mode.js"></script>

  <script>
    // Funkcja do wysyłania wiadomości wiatru
    async function sendWiatr(wiatrType) {
      const channelId = document.getElementById('channelSelect').value;
      const statusAlert = document.getElementById('statusAlert');

      // Sprawdź czy kanał został wybrany
      if (!channelId) {
        showAlert('Proszę wybrać kanał przed wysłaniem wiadomości.', 'danger');
        return;
      }

      // Pokaż loading
      showAlert('Wysyłanie wiadomości...', 'info');

      try {
        const response = await fetch(`/api/guilds/<%= guild.id %>/wiatry/send`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            channelId: channelId,
            wiatrType: wiatrType
          })
        });

        const data = await response.json();

        if (data.success) {
          showAlert('Wiadomość została wysłana pomyślnie!', 'success');
        } else {
          showAlert('Błąd: ' + (data.error || 'Nieznany błąd'), 'danger');
        }
      } catch (error) {
        console.error('Błąd podczas wysyłania wiadomości:', error);
        showAlert('Wystąpił błąd podczas wysyłania wiadomości.', 'danger');
      }
    }

    // Funkcja do pokazywania alertów
    function showAlert(message, type) {
      const statusAlert = document.getElementById('statusAlert');
      statusAlert.className = `alert alert-${type}`;
      statusAlert.textContent = message;
      statusAlert.style.display = 'block';

      // Ukryj alert po 5 sekundach dla sukcesu
      if (type === 'success') {
        setTimeout(() => {
          statusAlert.style.display = 'none';
        }, 5000);
      }
    }

    // Funkcjonalność ulubionych kanałów
    async function toggleFavoriteChannel(channelSelectId, iconId) {
      const select = document.getElementById(channelSelectId);
      const icon = document.getElementById(iconId);
      const selectedOption = select.options[select.selectedIndex];
      if (!selectedOption || !selectedOption.value) return;

      const channelId = selectedOption.value;
      const isCurrentlyFavorite = selectedOption.getAttribute('data-favorite') === 'true';
      const guildId = '<%= guild.id %>';

      try {
        // Pobierz aktualne ulubione kanały
        const getRes = await fetch(`/api/guilds/${guildId}/favorite-channels`);
        const getData = await getRes.json();

        if (!getData.success) {
          alert('Błąd podczas pobierania ulubionych kanałów');
          return;
        }

        let favoriteChannels = getData.favoriteChannels || [];

        // Przełącz ulubione
        if (isCurrentlyFavorite) {
          favoriteChannels = favoriteChannels.filter(id => id !== channelId);
          selectedOption.setAttribute('data-favorite', 'false');
          selectedOption.innerHTML = `#${selectedOption.textContent.replace('★ ', '')}`;
          icon.classList.remove('fas');
          icon.classList.add('far');
        } else {
          favoriteChannels.push(channelId);
          selectedOption.setAttribute('data-favorite', 'true');
          selectedOption.innerHTML = `★ #${selectedOption.textContent.replace('★ ', '')}`;
          icon.classList.remove('far');
          icon.classList.add('fas');
        }

        // Zapisz zmiany
        const putRes = await fetch(`/api/guilds/${guildId}/favorite-channels`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ favoriteChannels })
        });

        const putData = await putRes.json();

        if (!putData.success) {
          alert('Błąd podczas zapisywania zmian');
          // Przywraca poprzedni stan
          location.reload();
          return;
        }

        // Odśwież dropdown
        await updateChannelSelect();

      } catch (error) {
        console.error('Błąd:', error);
        alert('Wystąpił błąd podczas zmiany ulubionych kanałów');
      }
    }

    async function updateChannelSelect() {
      const guildId = '<%= guild.id %>';

      try {
        // Pobierz aktualne ulubione kanały
        const res = await fetch(`/api/guilds/${guildId}/favorite-channels`);
        const data = await res.json();

        if (!data.success) return;

        const favorites = data.favoriteChannels || [];

        // Zaktualizuj dropdown kanałów
        const select = document.getElementById('channelSelect');
        Array.from(select.options).forEach(option => {
          if (option.value) {
            const channelId = option.value;
            const isFavorite = favorites.includes(channelId);
            const displayText = option.textContent.replace('★ ', '').replace('★', '');
            option.setAttribute('data-favorite', isFavorite.toString());
            option.innerHTML = isFavorite ? `★ ${displayText}` : displayText;
          }
        });

        // Zaktualizuj ikony przycisków
        updateFavoriteIcon();

      } catch (error) {
        console.error('Błąd podczas aktualizacji dropdown:', error);
      }
    }

    function updateFavoriteIcon() {
      const select = document.getElementById('channelSelect');
      const icon = document.getElementById('favoriteIconWiatry');

      if (select && icon) {
        const selectedOption = select.options[select.selectedIndex];
        const isFavorite = selectedOption && selectedOption.getAttribute('data-favorite') === 'true';

        if (isFavorite) {
          icon.classList.remove('far');
          icon.classList.add('fas');
        } else {
          icon.classList.remove('fas');
          icon.classList.add('far');
        }
      }
    }

    // Obsługa zmiany wyboru w dropdown kanałów
    document.addEventListener('change', function(e) {
      if (e.target.classList.contains('channel-select')) {
        updateFavoriteIcon();
      }
    });

    // Dodaj obsługę kliknięć przycisków ulubionych
    document.addEventListener('DOMContentLoaded', function() {
      document.getElementById('favoriteChannelBtnWiatry').addEventListener('click', function() {
        console.log('Kliknięto przycisk ulubionych wiatrów');
        toggleFavoriteChannel('channelSelect', 'favoriteIconWiatry');
      });

      // Sprawdź dostępność przycisku
      console.log('Przycisk ulubionych wiatrów:', document.getElementById('favoriteChannelBtnWiatry'));
      updateFavoriteIcon(); // Inicjalizuj ikony ulubionych
    });
  </script>
</body>
</html>
